---
const base = import.meta.env.BASE_URL;
---
<div id="background-settings" class="fixed inset-0 z-[70] hidden items-center justify-center bg-black/65 p-4 backdrop-blur-sm" aria-hidden="true">
  <section class="glass w-full max-w-lg rounded-3xl p-5 sm:p-6" role="dialog" aria-modal="true" aria-labelledby="bg-title">
    <div class="mb-5 flex items-start justify-between">
      <div>
        <p class="text-xs tracking-[.22em] text-violet-300">PERSONALIZE</p>
        <h2 id="bg-title" class="mt-1 text-xl font-bold">背景外观设置</h2>
        <p class="mt-1 text-xs text-slate-400">设置仅保存在当前浏览器，不会影响其他访客。</p>
      </div>
      <button id="close-bg-settings" class="rounded-lg px-3 py-1 text-xl text-slate-400 hover:bg-white/10" aria-label="关闭">×</button>
    </div>
    <div class="space-y-5">
      <div>
        <label class="mb-2 block text-sm font-semibold">选择背景</label>
        <div class="grid grid-cols-3 gap-2">
          <button class="bg-choice overflow-hidden rounded-xl border-2 border-violet-300 p-1" data-bg="space" aria-label="星空背景">
            <img class="h-16 w-full rounded-lg object-cover" src="https://images.unsplash.com/photo-1462331940025-496dfbfc7564?auto=format&fit=crop&w=500&q=75" alt="星空背景预览" />
            <span class="block py-1 text-xs">深空</span>
          </button>
          <button class="bg-choice overflow-hidden rounded-xl border-2 border-transparent p-1" data-bg="mountain" aria-label="山脉背景">
            <img class="h-16 w-full rounded-lg object-cover" src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=500&q=75" alt="山脉背景预览" />
            <span class="block py-1 text-xs">山脉</span>
          </button>
          <button class="bg-choice overflow-hidden rounded-xl border-2 border-transparent p-1" data-bg="abstract" aria-label="抽象背景">
            <img class="h-16 w-full rounded-lg object-cover" src="https://images.unsplash.com/photo-1519608487953-e999c86e7455?auto=format&fit=crop&w=500&q=75" alt="抽象背景预览" />
            <span class="block py-1 text-xs">夜色</span>
          </button>
        </div>
      </div>
      <div class="space-y-4">
        <label class="block text-sm">遮罩透明度 <output id="overlay-value" class="float-right text-violet-200">68%</output>
          <input id="overlay-range" class="mt-2 w-full accent-violet-400" type="range" min="0" max="90" value="68" />
        </label>
        <label class="block text-sm">背景模糊 <output id="blur-value" class="float-right text-violet-200">0 px</output>
          <input id="blur-range" class="mt-2 w-full accent-violet-400" type="range" min="0" max="16" value="0" />
        </label>
        <label class="block text-sm">背景亮度 <output id="brightness-value" class="float-right text-violet-200">78%</output>
          <input id="brightness-range" class="mt-2 w-full accent-violet-400" type="range" min="30" max="140" value="78" />
        </label>
      </div>
    </div>
    <div class="mt-6 flex items-center justify-between border-t border-white/10 pt-4">
      <button id="reset-bg-settings" class="text-sm text-slate-400 hover:text-white">恢复默认</button>
      <button id="save-bg-settings" class="btn-primary text-sm">保存设置</button>
    </div>
  </section>
</div>
<script define:vars={{ base }}>
  const overlay = document.querySelector("#background-settings");
  const defaults = { bg: "space", overlay: 68, blur: 0, brightness: 78 };
  const backgrounds = {
    space: "https://images.unsplash.com/photo-1462331940025-496dfbfc7564?auto=format&fit=crop&w=2400&q=85",
    mountain: "https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=2400&q=85",
    abstract: "https://images.unsplash.com/photo-1519608487953-e999c86e7455?auto=format&fit=crop&w=2400&q=85"
  };
  let settings = { ...defaults };
  const $ = (id) => document.getElementById(id);
  const apply = (persist = false) => {
    document.documentElement.style.setProperty("--site-bg-image", `url("${backgrounds[settings.bg]}")`);
    document.documentElement.style.setProperty("--site-bg-overlay", String(settings.overlay / 100));
    document.documentElement.style.setProperty("--site-bg-blur", `${settings.blur}px`);
    document.documentElement.style.setProperty("--site-bg-brightness", String(settings.brightness / 100));
    $("overlay-range").value = settings.overlay;
    $("blur-range").value = settings.blur;
    $("brightness-range").value = settings.brightness;
    $("overlay-value").textContent = `${settings.overlay}%`;
    $("blur-value").textContent = `${settings.blur} px`;
    $("brightness-value").textContent = `${settings.brightness}%`;
    document.querySelectorAll(".bg-choice").forEach((button) => {
      button.classList.toggle("border-violet-300", button.dataset.bg === settings.bg);
      button.classList.toggle("border-transparent", button.dataset.bg !== settings.bg);
    });
    if (persist) localStorage.setItem("nanshan-blog-background", JSON.stringify(settings));
  };
  try {
    const saved = JSON.parse(localStorage.getItem("nanshan-blog-background") || "null");
    if (saved && backgrounds[saved.bg] && Number.isFinite(saved.overlay) && Number.isFinite(saved.blur) && Number.isFinite(saved.brightness)) {
      settings = { ...defaults, ...saved };
    }
  } catch {}
  apply(false);
  const open = () => {
    overlay.classList.remove("hidden");
    overlay.classList.add("flex");
    overlay.setAttribute("aria-hidden", "false");
  };
  const close = () => {
    overlay.classList.add("hidden");
    overlay.classList.remove("flex");
    overlay.setAttribute("aria-hidden", "true");
  };
  window.addEventListener("open-background-settings", open);
  $("close-bg-settings").addEventListener("click", close);
  overlay.addEventListener("click", (event) => { if (event.target === overlay) close(); });
  document.addEventListener("keydown", (event) => { if (event.key === "Escape") close(); });
  document.querySelectorAll(".bg-choice").forEach((button) => button.addEventListener("click", () => {
    settings.bg = button.dataset.bg;
    apply(false);
  }));
  [["overlay-range", "overlay"], ["blur-range", "blur"], ["brightness-range", "brightness"]].forEach(([id, key]) => {
    $(id).addEventListener("input", (event) => {
      settings[key] = Number(event.target.value);
      apply(false);
    });
  });
  $("save-bg-settings").addEventListener("click", () => { apply(true); close(); });
  $("reset-bg-settings").addEventListener("click", () => { settings = { ...defaults }; apply(false); });
</script>
