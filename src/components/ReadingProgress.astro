<div id="reading-progress" class="fixed left-0 top-0 z-[60] h-[3px] w-0 bg-gradient-to-r from-violet-400 via-fuchsia-300 to-cyan-300 shadow-[0_0_12px_rgba(139,123,255,.7)]" aria-hidden="true"></div>
<script>
const bar=document.querySelector<HTMLElement>("#reading-progress"); let ticking=false;
const update=()=>{const max=document.documentElement.scrollHeight-window.innerHeight;const value=max>0?window.scrollY/max*100:0;if(bar)bar.style.width=`${Math.min(100,Math.max(0,value))}%`;ticking=false;};
window.addEventListener("scroll",()=>{if(!ticking){requestAnimationFrame(update);ticking=true;}},{passive:true});window.addEventListener("resize",update);update();
</script>
