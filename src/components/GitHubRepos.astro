---
import { githubConfig } from "@/data/github";
---
<section class="mt-16">
 <div class="mb-6 flex flex-wrap items-end justify-between gap-3"><div><p class="text-xs tracking-[.25em] text-violet-300">OPEN SOURCE / GITHUB</p><h2 class="mt-2 text-2xl font-bold">GitHub 开源项目</h2></div>{githubConfig.username !== "YOUR_GITHUB_USERNAME" && <a class="text-sm text-violet-200" href={`https://github.com/${githubConfig.username}`} target="_blank" rel="noreferrer">访问 GitHub ↗</a>}</div>
 <div id="github-repos" class="grid gap-4 md:grid-cols-2"><div class="panel p-5 text-sm text-slate-400">正在读取公开仓库信息…</div></div><p id="github-status" class="mt-3 text-xs text-slate-500" aria-live="polite"></p>
</section>
<script define:vars={{ config: githubConfig }}>
const host=document.querySelector("#github-repos"),status=document.querySelector("#github-status");
const esc=(v)=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const fallback=[{name:"Solar System Simulator",description:"Modern OpenGL solar system simulation.",html_url:"https://github.com/",language:"C++",stargazers_count:0,forks_count:0,updated_at:new Date().toISOString()},{name:"AI Research Notes",description:"Experiments on generative AI systems.",html_url:"https://github.com/",language:"Python",stargazers_count:0,forks_count:0,updated_at:new Date().toISOString()}];
const render=(repos)=>{if(!host)return;host.innerHTML=repos.map(r=>`<a class="panel card-hover block p-5" href="${esc(r.html_url)}" target="_blank" rel="noreferrer"><div class="flex justify-between gap-3"><h3 class="truncate font-semibold text-violet-100">${esc(r.name)}</h3><span>↗</span></div><p class="mt-3 min-h-12 text-sm leading-6 text-slate-400">${esc(r.description||"暂无项目描述")}</p><div class="mt-4 flex flex-wrap gap-4 text-xs text-slate-500"><span>${esc(r.language||"Code")}</span><span>★ ${Number(r.stargazers_count||0)}</span><span>⑂ ${Number(r.forks_count||0)}</span><span>${new Date(r.updated_at).toLocaleDateString()}</span></div></a>`).join("");};
if(!config.username||config.username==="YOUR_GITHUB_USERNAME"){render(fallback);if(status)status.textContent="请在 src/data/github.ts 中填写 GitHub 用户名；当前为演示数据。";}else{try{const res=await fetch(`https://api.github.com/users/${encodeURIComponent(config.username)}/repos?sort=updated&per_page=100&type=owner`,{headers:{Accept:"application/vnd.github+json"}});if(!res.ok)throw Error(`GitHub API ${res.status}`);let repos=await res.json();if(config.excludeForks)repos=repos.filter(r=>!r.fork);if(config.pinnedRepos?.length)repos.sort((a,b)=>{const ai=config.pinnedRepos.indexOf(a.name),bi=config.pinnedRepos.indexOf(b.name);return (ai<0?999:ai)-(bi<0?999:bi);});repos=repos.slice(0,config.maxRepos);render(repos.length?repos:fallback);if(status)status.textContent=repos.length?`数据来自 GitHub 公共 API · ${config.username}`:"没有公开仓库，当前显示演示项目。";}catch{render(fallback);if(status)status.textContent="GitHub API 暂不可用，已降级显示演示项目。";}}
</script>
