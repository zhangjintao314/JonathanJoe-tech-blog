---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { projects } from "@/data/projects";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const slugOf = (id: string) => id.replace(/\.(md|mdx)$/i, "");
const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---
<BaseLayout title="Jonathan Joe" description="Jonathan Joe 的个人技术品牌空间，记录软件工程、人工智能、软硬件系统与创造。">
  <section class="hero-shell">
    <div class="hero-grid"></div><div class="hero-orb hero-orb-one"></div><div class="hero-orb hero-orb-two"></div>
    <div class="container-wide relative grid min-h-[680px] items-center gap-14 py-20 lg:grid-cols-[1.12fr_.88fr]">
      <div class="animate-rise"><div class="hero-status"><span class="status-pulse"></span> INDEPENDENT ENGINEER · ALWAYS BUILDING</div><p class="section-kicker mt-8">SOFTWARE / ARTIFICIAL INTELLIGENCE / SYSTEMS</p>
        <h1 class="hero-title mt-5">探索技术边界，<br/><span class="gradient-text">构建真实世界。</span></h1>
        <p class="mt-7 max-w-2xl text-base leading-8 text-slate-300 sm:text-lg">你好，我是 <strong class="text-white">Jonathan Joe</strong>。这里记录工程实践、人工智能研究、底层系统，以及那些值得亲手实现的想法。</p>
        <div class="mt-9 flex flex-wrap gap-3"><a class="btn-primary" href={`${base}blog/`}>探索技术文章 ↗</a><a class="btn-secondary" href={`${base}projects/`}>查看工程项目</a></div>
        <div class="mt-14 grid max-w-xl grid-cols-3 gap-5 border-t border-white/10 pt-6"><div><p class="stat-number">01</p><p class="mt-1 text-xs text-slate-500">ENGINEERING</p></div><div><p class="stat-number">02</p><p class="mt-1 text-xs text-slate-500">ARTIFICIAL INTELLIGENCE</p></div><div><p class="stat-number">∞</p><p class="mt-1 text-xs text-slate-500">CURIOSITY</p></div></div>
      </div>
      <div class="hero-console-wrap animate-rise" style="animation-delay:160ms"><div class="hero-console glass"><div class="flex items-center justify-between border-b border-white/10 pb-4"><div class="flex items-center gap-2"><span class="console-dot"></span><span class="console-dot"></span><span class="console-dot"></span></div><span class="text-[10px] tracking-[.2em] text-slate-500">JONATHAN / CORE</span></div>
        <div class="relative flex min-h-[310px] items-center justify-center overflow-hidden"><div class="orbit orbit-a"></div><div class="orbit orbit-b"></div><div class="orbit orbit-c"></div><div class="core-monogram">J<span>.</span></div><span class="orbit-label label-ai">AI / MODELS</span><span class="orbit-label label-sys">SYSTEMS</span><span class="orbit-label label-build">BUILD / TEST</span></div>
        <div class="grid grid-cols-2 gap-3 border-t border-white/10 pt-5 text-xs"><div><p class="text-slate-500">CURRENT FOCUS</p><p class="mt-2 font-semibold text-slate-200">Generative AI · World Models</p></div><div><p class="text-slate-500">WORKING PRINCIPLE</p><p class="mt-2 font-semibold text-slate-200">Research × Engineering</p></div></div></div><div class="console-float glass"><span class="text-violet-200">✳</span><span><b class="block text-xs text-white">Learn by building</b><small class="text-[10px] text-slate-500">Ideas become systems.</small></span></div></div>
    </div>
  </section>
  <section class="container-wide py-14 sm:py-20"><div class="mb-8 flex items-end justify-between"><div><p class="section-kicker">LATEST WRITING / 01</p><h2 class="mt-3 text-3xl font-bold">最新文章<span class="gradient-text">.</span></h2></div><a class="text-sm text-violet-200" href={`${base}blog/`}>全部文章 ↗</a></div><div class="grid gap-4 md:grid-cols-3">{posts.map((post,index)=><a class="panel card-hover p-6" href={`${base}blog/${slugOf(post.id)}/`}><p class="text-xs text-violet-300">NOTE / 0{index+1} · {post.data.category}</p><h3 class="mt-5 text-lg font-bold">{post.data.title}</h3><p class="mt-3 line-clamp-3 text-sm leading-7 text-slate-400">{post.data.description}</p><span class="mt-6 inline-block text-sm text-violet-200">阅读全文 →</span></a>)}</div></section>
  <section class="container-wide py-10"><div class="mb-8"><p class="section-kicker">SELECTED WORK / 02</p><h2 class="mt-3 text-3xl font-bold">正在探索的项目<span class="gradient-text">.</span></h2></div><div class="grid gap-4 md:grid-cols-3">{projects.map((project,index)=><article class="panel card-hover p-6"><p class="text-xs text-slate-500">PROJECT / 0{index+1} · {project.category}</p><h3 class="mt-5 text-lg font-bold">{project.title}</h3><p class="mt-3 min-h-20 text-sm leading-7 text-slate-400">{project.description}</p><div class="mt-5 flex flex-wrap gap-2">{project.tags.map(tag=><span class="tag-pill">{tag}</span>)}</div></article>)}</div><div class="mt-6 text-right"><a class="text-sm text-violet-200" href={`${base}projects/`}>查看全部项目 ↗</a></div></section>
  <section class="container-wide py-14"><div class="contact-panel glass relative overflow-hidden rounded-3xl p-8 sm:p-12"><div class="relative z-10 max-w-2xl"><p class="section-kicker">LET'S CONNECT / 03</p><h2 class="mt-4 text-3xl font-black sm:text-4xl">保持好奇，保持创造。</h2><p class="mt-4 leading-8 text-slate-400">欢迎交流人工智能、系统工程、开源项目与技术实践。</p><a class="btn-primary mt-7" href="https://github.com/zhangjintao314" target="_blank" rel="noreferrer">在 GitHub 上找到我 ↗</a></div></div></section>
</BaseLayout>
