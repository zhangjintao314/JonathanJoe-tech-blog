---
import BaseLayout from "@/layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="页面不存在">
  <section class="container-wide grid min-h-[55vh] place-items-center py-20 text-center">
    <div><p class="text-sm tracking-[.3em] text-violet-300">404 / NOT FOUND</p><h1 class="mt-5 text-6xl font-black">迷失在宇宙中？</h1><p class="mt-5 text-slate-400">你访问的页面不存在，或者已经移动。</p><a class="btn-primary mt-8" href={base}>返回首页</a></div>
  </section>
</BaseLayout>
