---
import "../styles/global.css";
import { site } from "@/data/site";
import BackgroundSettings from "@/components/BackgroundSettings.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ReadingProgress from "@/components/ReadingProgress.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
}
const { title = site.name, description = site.description, image, type = "website" } = Astro.props;
const fullTitle = title === site.name ? title : `${title} — ${site.name}`;
const base = import.meta.env.BASE_URL;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image ? new URL(image, Astro.site).toString() : new URL(`${base}favicon.svg`, Astro.site).toString();
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080b17" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href={`${base}rss.xml`} />
    <title>{fullTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <ReadingProgress />
    <Header />
    <main><slot /></main>
    <Footer />
    <BackgroundSettings />
  </body>
</html>
